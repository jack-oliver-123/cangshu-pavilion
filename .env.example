DATABASE_URL=postgres://cangshu:cangshu@localhost:5432/cangshu
CANGSHU_HOST=127.0.0.1
CANGSHU_PORT=4100
CANGSHU_DATA_DIR=./data
# Optional canonical Base64 encoding of exactly 32 random bytes.
CANGSHU_MASTER_KEY=
# Non-loopback binding, including the Docker container listener, requires 12+ characters.
CANGSHU_SHARED_PASSWORD=replace-with-a-long-random-password
# Optional environment overrides for provider settings.
CANGSHU_CHAT_BASE_URL=https://api.openai.com/v1
CANGSHU_CHAT_MODEL=
CANGSHU_CHAT_API_KEY=
CANGSHU_EMBEDDING_BASE_URL=https://api.openai.com/v1
CANGSHU_EMBEDDING_MODEL=
CANGSHU_EMBEDDING_API_KEY=
